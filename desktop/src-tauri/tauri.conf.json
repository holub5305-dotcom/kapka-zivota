{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kapka života",
  "version": "1.0.0",
  "identifier": "cz.kapkazivota.app",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kapka života",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Czech", "English"]
      }
    },
    "shortDescription": "Dárcovský deník Kapka života",
    "longDescription": "Osobní deník a připomínky pro dárce krve a plazmy. Data zůstávají ve Vašem zařízení."
  }
}
